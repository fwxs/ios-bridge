include README.md
include LICENSE
include INSTALL.md
include USAGE.md
include PROJECT_SUMMARY.md
include COMPLETE_TEST_GUIDE.md
include TESTING_GUIDE.md
include pyproject.toml
include requirements.txt
include build_and_package.py
include bundle_server.py
include generate_icons.py

# Include Electron app
recursive-include ios_bridge_cli/electron_app *.json *.js *.html *.css *.png *.ico *.icns *.svg *.plist
recursive-include ios_bridge_cli/electron_app/src *
recursive-include ios_bridge_cli/electron_app/assets *

# Include bundled server (created by bundle_server.py)
recursive-include ios_bridge_cli/server *.py *.html *.js

# Exclude development and build files
prune build
prune ios_bridge_cli/electron_app/node_modules
prune ios_bridge_cli/electron_app/dist
global-exclude __pycache__ *.py[co] .DS_Store
prune dist
prune *.egg-info